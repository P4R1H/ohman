<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0E1014" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Surface" Color="#161920"/>
    <SolidColorBrush x:Key="Line" Color="#1F232C"/>
    <SolidColorBrush x:Key="Text" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="Muted" Color="#A4ADBF"/>
    <SolidColorBrush x:Key="Accent" Color="#5B8DEF"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>
    <Style x:Key="SubSm" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="Divider" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{StaticResource Line}"/>
      <Setter Property="Margin" Value="0,14,0,14"/>
    </Style>

    <Style x:Key="SegBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="70"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="12,6">
              <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="#A4ADBF" TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"
                                TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1E222B"/>
                <Setter TargetName="CP" Property="TextElement.Foreground" Value="#ECEFF4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2A3140"/>
                <Setter TargetName="CP" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegTight" TargetType="RadioButton" BasedOn="{StaticResource Seg}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="6,6">
              <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="#A4ADBF" TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1E222B"/>
                <Setter TargetName="CP" Property="TextElement.Foreground" Value="#ECEFF4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2A3140"/>
                <Setter TargetName="CP" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent" MinHeight="36">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
              <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="#2B3140" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#A4ADBF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="KnobT" X="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#5B8DEF"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="B" CornerRadius="8" Background="{StaticResource Surface}" Padding="9,6">
              <ContentPresenter x:Name="CP" TextElement.Foreground="#A4ADBF" TextElement.FontSize="10.5" TextElement.FontWeight="Bold"
                                TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="#5B8DEF"/>
                <Setter TargetName="CP" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Sl" TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="26" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#262B36" VerticalAlignment="Center" Margin="7,0"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                          <Border Height="4" CornerRadius="2" Background="#5B8DEF" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#ECEFF4" Stroke="#5B8DEF" StrokeThickness="2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1E222B"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#C03A3A"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TextBtn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="8" Background="{StaticResource Surface}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#22272F"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2A3140"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="4,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Dot" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Ellipse x:Name="E" Fill="{TemplateBinding Background}" Stroke="#30000000" StrokeThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="E" Property="Stroke" Value="#ECEFF4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Hex" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlHue" TargetType="Slider" BasedOn="{StaticResource Sl}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="26" Background="Transparent">
              <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="7,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.167"/><GradientStop Color="#00FF00" Offset="0.333"/>
                    <GradientStop Color="#00FFFF" Offset="0.5"/><GradientStop Color="#0000FF" Offset="0.667"/><GradientStop Color="#FF00FF" Offset="0.833"/><GradientStop Color="#FF0000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False" Cursor="Hand">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#ECEFF4" Stroke="#0E1014" StrokeThickness="2"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Width="5" Margin="0,4">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="2.5" Background="#3A4150"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- keyboard editor: lives in its own window, docked beside the panel (see BuildKeyboardWindow) -->
  <Border x:Name="KbdPanel" Grid.Column="0" Width="754" Visibility="Collapsed">
    <Grid Margin="18,0,18,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="KbdHeader" Background="Transparent" Cursor="SizeAll">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Keyboard" FontFamily="{StaticResource HeadFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
          <TextBlock x:Name="TxtKbdKind" Style="{StaticResource SubSm}" Margin="8,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="BtnKbdClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-8,0" ToolTip="Close"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="460"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- left: mode bar over the keyboard, same width -->
        <StackPanel x:Name="KbdLeft">
          <Border Style="{StaticResource SegBox}" Margin="0,0,0,12">
            <UniformGrid Rows="1">
              <RadioButton x:Name="KOff" Style="{StaticResource SegTight}" GroupName="kbd" Content="Off"/>
              <RadioButton x:Name="KStatic" Style="{StaticResource SegTight}" GroupName="kbd" Content="Static"/>
              <RadioButton x:Name="KBreathe" Style="{StaticResource SegTight}" GroupName="kbd" Content="Breathe"/>
              <RadioButton x:Name="KCycle" Style="{StaticResource SegTight}" GroupName="kbd" Content="Cycle"/>
              <RadioButton x:Name="KWave" Style="{StaticResource SegTight}" GroupName="kbd" Content="Wave"/>
              <RadioButton x:Name="KWin" Style="{StaticResource SegTight}" GroupName="kbd" Content="Windows" ToolTip="Hand the keyboard to Windows Dynamic Lighting"/>
            </UniformGrid>
          </Border>
          <Border x:Name="KbdHost"/>
        </StackPanel>
        <!-- right: controls, exactly as tall as the left column (height set in code) -->
        <Grid x:Name="Picker" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Static / Breathe: which zone, and the exact value -->
          <Grid x:Name="ColourHead" Height="32">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TxtKbdSel" Style="{StaticResource Lbl}"/>
              <Button x:Name="BtnAllZones" Style="{StaticResource LinkBtn}" Content="All zones" Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="Colour every zone at once (Ctrl-click keys to add zones one by one)"/>
            </StackPanel>
            <TextBox x:Name="TxtHex" Grid.Column="1" Style="{StaticResource Hex}" MaxLength="7" Width="88" TextAlignment="Center" Padding="6,5" VerticalAlignment="Center"/>
          </Grid>
          <!-- Cycle / Wave / Off / Windows: what is going on instead -->
          <StackPanel x:Name="InfoBlock" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,4,0,0">
            <TextBlock x:Name="TxtKbdInfo" Style="{StaticResource Sub}" FontSize="12.5"/>
            <Button x:Name="BtnWinLighting" Style="{StaticResource LinkBtn}" Content="Open Windows lighting settings" HorizontalAlignment="Left" Margin="-4,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <Grid x:Name="SvBox" Grid.Row="1" Margin="0,10,0,0" Cursor="Cross" Background="Transparent">
            <Rectangle x:Name="SvHue" RadiusX="8" RadiusY="8" Fill="#FF0000"/>
            <Rectangle RadiusX="8" RadiusY="8">
              <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
            <Rectangle RadiusX="8" RadiusY="8">
              <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
            </Rectangle>
            <Canvas x:Name="SvCanvas" ClipToBounds="False">
              <Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
            </Canvas>
          </Grid>
          <Slider x:Name="SlHue" Grid.Row="2" Style="{StaticResource SlHue}" Minimum="0" Maximum="359" IsSnapToTickEnabled="True" TickFrequency="1" Margin="-7,10,-7,0"/>
          <Grid x:Name="SpeedRow" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="46"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Speed" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
            <Slider x:Name="SlSpeed" Grid.Column="1" Style="{StaticResource Sl}" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"/>
            <TextBlock x:Name="TxtSpeed" Grid.Column="2" Style="{StaticResource Mono}" FontSize="11.5"/>
          </Grid>
          <Grid x:Name="LevelRow" Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="46"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Level" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
            <Slider x:Name="SlLevel" Grid.Column="1" Style="{StaticResource Sl}" Minimum="5" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"/>
            <TextBlock x:Name="TxtLevel" Grid.Column="2" Style="{StaticResource Mono}" FontSize="11.5"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>

  <!-- the panel: header, body, footer -->
  <Grid Grid.Column="1">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- header -->
  <Grid x:Name="Header" Height="54" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
      <Grid Width="28" Height="28">
        <Border x:Name="Mark" Width="19" Height="19" CornerRadius="4.5" Background="#5B8DEF" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <RotateTransform Angle="45"/>
          </Border.RenderTransform>
          <Border Width="7.5" Height="7.5" CornerRadius="1.8" Background="#0E1014"/>
        </Border>
      </Grid>
      <TextBlock x:Name="TxtTitle" Text="Ohman" FontFamily="{StaticResource HeadFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="9,0,0,1" VerticalAlignment="Center"/>
      <Border x:Name="DemoBadge" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="5" Background="#33FFB84D" Padding="6,1" VerticalAlignment="Center" ToolTip="Not running as administrator: hardware is simulated">
        <TextBlock Text="DEMO" FontSize="9.5" FontWeight="Bold" Foreground="#FFB84D" FontFamily="{StaticResource UiFont}"/>
      </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
      <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}" ToolTip="Settings"/>
      <Button x:Name="BtnMin" Style="{StaticResource IconBtn}" Content="&#xE921;" ToolTip="Minimize to tray"/>
      <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" ToolTip="Hide (keeps running in the tray)"/>
    </StackPanel>
  </Grid>

  <!-- body -->
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="18,4,18,16">

      <Border x:Name="ErrBanner" Visibility="Collapsed" Background="#26FF5C5C" CornerRadius="8" Padding="10,7" Margin="0,0,0,12">
        <TextBlock x:Name="TxtErr" Style="{StaticResource Sub}" Foreground="#FF9A9A" Margin="0"/>
      </Border>
      <Border x:Name="InfoBanner" Visibility="Collapsed" Background="#1F5B8DEF" CornerRadius="8" Padding="10,7" Margin="0,0,0,12">
        <TextBlock x:Name="TxtInfo" Style="{StaticResource Sub}" Foreground="#B9CDF7" Margin="0"/>
      </Border>

      <StackPanel x:Name="MainPanel">
        <!-- mode -->
        <Border Style="{StaticResource SegBox}" Padding="3">
          <UniformGrid x:Name="ModeGrid" Rows="1"/>
        </Border>
        <TextBlock x:Name="TxtModeSub" Style="{StaticResource Sub}" Margin="4,8,0,0"/>

        <!-- metrics -->
        <UniformGrid x:Name="TileGrid" Columns="4" Margin="0,16,0,0"/>
        <TextBlock x:Name="TxtSensors" Style="{StaticResource Sub}" Margin="4,8,0,0" Text=""/>

        <Rectangle Style="{StaticResource Divider}"/>

        <!-- fans -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Fans" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="TxtFanSub" Style="{StaticResource Sub}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource SegBox}" VerticalAlignment="Center">
            <UniformGrid Rows="1">
              <RadioButton x:Name="FanAuto" Style="{StaticResource Seg}" GroupName="fan" Content="Auto" IsChecked="True"/>
              <RadioButton x:Name="FanMax" Style="{StaticResource Seg}" GroupName="fan" Content="Max"/>
              <RadioButton x:Name="FanManual" Style="{StaticResource Seg}" GroupName="fan" Content="Manual"/>
            </UniformGrid>
          </Border>
        </Grid>
        <StackPanel x:Name="FanPanel" Visibility="Collapsed" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="74"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Sub}" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="SlFan1" Grid.Column="1" Style="{StaticResource Sl}" Minimum="18" Maximum="57" IsSnapToTickEnabled="True" TickFrequency="1"/>
            <TextBlock x:Name="TxtFan1" Grid.Column="2" Style="{StaticResource Mono}" FontSize="12"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="74"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GPU" Style="{StaticResource Sub}" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="SlFan2" Grid.Column="1" Style="{StaticResource Sl}" Minimum="18" Maximum="57" IsSnapToTickEnabled="True" TickFrequency="1"/>
            <TextBlock x:Name="TxtFan2" Grid.Column="2" Style="{StaticResource Mono}" FontSize="12"/>
          </Grid>
        </StackPanel>

        <Rectangle x:Name="PowerDivider" Style="{StaticResource Divider}"/>

        <!-- cpu power -->
        <Grid x:Name="PowerRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Power gain" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="TxtPowerSub" Style="{StaticResource Sub}" Text="Dynamic Boost · 30 W"/>
          </StackPanel>
          <Slider x:Name="SlPower" Grid.Column="1" Style="{StaticResource Sl}" Minimum="0" Maximum="15" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="6,0"
                  ToolTip="What OMEN Gaming Hub calls Smart Performance Gain: raises the shared CPU + GPU power budget so NVIDIA Dynamic Boost has more headroom. Affects the GPU more than the CPU."/>
          <TextBlock x:Name="TxtPower" Grid.Column="2" Style="{StaticResource Mono}" FontSize="14" Text="+0 W"/>
        </Grid>

        <Rectangle x:Name="GpuDivider" Style="{StaticResource Divider}"/>

        <!-- gpu power -->
        <Grid x:Name="GpuRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GPU power" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="TxtGpuSub" Style="{StaticResource Sub}"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource SegBox}" VerticalAlignment="Center">
            <UniformGrid Rows="1">
              <RadioButton x:Name="GpuBase" Style="{StaticResource Seg}" GroupName="gpu" Content="Base"/>
              <RadioButton x:Name="GpuBoost" Style="{StaticResource Seg}" GroupName="gpu" Content="Boost"/>
              <RadioButton x:Name="GpuMax" Style="{StaticResource Seg}" GroupName="gpu" Content="Max"/>
            </UniformGrid>
          </Border>
          <ToggleButton x:Name="TgGpuAuto" Grid.Column="2" Style="{StaticResource PillToggle}" Content="AUTO" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Follow the mode: Eco → Base, Balanced → Boost, Performance → Max"/>
        </Grid>

        <Rectangle x:Name="LightDivider" Style="{StaticResource Divider}"/>

        <!-- keyboard lighting: a live glyph, click to edit -->
        <Grid x:Name="LightRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Lighting" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="TxtLightSub" Style="{StaticResource Sub}"/>
          </StackPanel>
          <Border x:Name="MiniHost" Grid.Column="1" Width="164" VerticalAlignment="Center" Cursor="Hand" ToolTip="Open the keyboard editor"/>
        </Grid>
      </StackPanel>

      <!-- settings page -->
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
        <Grid Margin="0,4,0,12">
          <TextBlock Text="Settings" FontFamily="{StaticResource HeadFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
          <TextBlock x:Name="TxtMachine" Style="{StaticResource SubSm}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="OMEN key" Style="{StaticResource Lbl}"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="TxtKeyInfo" Style="{StaticResource SubSm}" VerticalAlignment="Center"/>
              <Button x:Name="BtnLearn" Style="{StaticResource LinkBtn}" Content="Learn" Margin="4,1,0,0" ToolTip="Click, then press the key you want to bind"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource SegBox}" VerticalAlignment="Center">
            <UniformGrid Rows="1">
              <RadioButton x:Name="KeyCycle" Style="{StaticResource Seg}" GroupName="key" Content="Cycle"/>
              <RadioButton x:Name="KeyShow" Style="{StaticResource Seg}" GroupName="key" Content="Panel"/>
              <RadioButton x:Name="KeyMax" Style="{StaticResource Seg}" GroupName="key" Content="Max fan"/>
              <RadioButton x:Name="KeyOff" Style="{StaticResource Seg}" GroupName="key" Content="Off"/>
            </UniformGrid>
          </Border>
        </Grid>

        <Rectangle Style="{StaticResource Divider}"/>

        <ToggleButton x:Name="TgSuppress" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock Text="Take over the OMEN key" Style="{StaticResource Lbl}"/>
            <TextBlock Text="Stops OMEN Gaming Hub's key handler and its logon task" Style="{StaticResource SubSm}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="TgHotkeys" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock Text="Hotkeys" Style="{StaticResource Lbl}"/>
            <TextBlock Text="Shift+F11 cycles modes · Ctrl+Alt+E / B / P modes · Ctrl+Alt+M max fan · Ctrl+Alt+O panel" Style="{StaticResource SubSm}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="TgEcoBattery" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock Text="Eco on battery" Style="{StaticResource Lbl}"/>
            <TextBlock Text="Restores your mode when plugged in" Style="{StaticResource SubSm}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="TgEcoCool" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock Text="Quieter fan policy for Eco" Style="{StaticResource Lbl}"/>
            <TextBlock Text="BIOS 'cool' policy (0x50) instead of the default curve OGH sends" Style="{StaticResource SubSm}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="TgSyncPower" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock Text="Sync Windows power mode" Style="{StaticResource Lbl}"/>
            <TextBlock Text="Efficiency · Balanced · Best performance" Style="{StaticResource SubSm}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="TgAutostart" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock Text="Start with Windows" Style="{StaticResource Lbl}"/>
            <TextBlock Text="Scheduled task, no UAC prompt at logon" Style="{StaticResource SubSm}"/>
          </StackPanel>
        </ToggleButton>

        <Rectangle Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnDiag" Style="{StaticResource TextBtn}" Content="Diagnostics"/>
          <Button x:Name="BtnLog" Style="{StaticResource TextBtn}" Content="Log" Margin="8,0,0,0"/>
          <Button x:Name="BtnExit" Style="{StaticResource TextBtn}" Content="Exit Ohman" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="TxtDiag" Style="{StaticResource SubSm}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,10,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

  <!-- footer -->
  <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
    <Grid Height="38" Margin="18,0,18,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="DotHb" Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtFoot" Style="{StaticResource Sub}" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="TxtKeyFoot" Style="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
    </Grid>
  </Border>

  </Grid>
</Grid>
