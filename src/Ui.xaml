<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Background="#161311" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
  <Grid.Resources>
    <!-- Accent and the two font families are installed from code (DynamicResource): the accent follows the mode,
         IBM Plex ships inside the exe. Every other value here comes straight from the panel design. -->
    <SolidColorBrush x:Key="Accent" Color="#3F8CFF"/>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <SolidColorBrush x:Key="Card" Color="#161311"/>
    <SolidColorBrush x:Key="Sunken" Color="#0F0D0B"/>
    <SolidColorBrush x:Key="Well" Color="#0D0B0A"/>
    <SolidColorBrush x:Key="Pill" Color="#201C19"/>
    <SolidColorBrush x:Key="Line" Color="#2C2825"/>
    <SolidColorBrush x:Key="Line2" Color="#272320"/>
    <SolidColorBrush x:Key="Edge" Color="#343029"/>
    <SolidColorBrush x:Key="Track" Color="#312D2A"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#36322F"/>
    <SolidColorBrush x:Key="KnobOff" Color="#8A8581"/>
    <SolidColorBrush x:Key="Text" Color="#EDEAE8"/>
    <SolidColorBrush x:Key="TextHi" Color="#F4F1EF"/>
    <SolidColorBrush x:Key="SegText" Color="#A8A3A0"/>
    <SolidColorBrush x:Key="Hex" Color="#A29D99"/>
    <SolidColorBrush x:Key="Sub" Color="#96918D"/>
    <SolidColorBrush x:Key="Desc" Color="#908B87"/>
    <SolidColorBrush x:Key="Status" Color="#8A8581"/>
    <SolidColorBrush x:Key="Axis" Color="#847F7B"/>
    <SolidColorBrush x:Key="Foot" Color="#7E7976"/>
    <SolidColorBrush x:Key="Section" Color="#787370"/>

    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="42"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="LineHeight" Value="46"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style x:Key="Row" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowSub" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Desc}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Cap" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Status}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MonoFoot" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
      <Setter Property="Foreground" Value="{StaticResource Foot}"/>
    </Style>
    <Style x:Key="MonoVal" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Width" Value="52"/>
    </Style>
    <Style x:Key="Link" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- toggle: 38 x 21 in settings rows, 40 x 22 on the pages (the design uses both) -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="38" Height="21" CornerRadius="11" Background="{StaticResource SwitchOff}" VerticalAlignment="Center">
              <Ellipse x:Name="Knob" Width="15" Height="15" Fill="{StaticResource KnobOff}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobT" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="17" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SwitchBig" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{StaticResource SwitchOff}" VerticalAlignment="Center">
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource KnobOff}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobT" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slider: 2 px rail, 14 px round thumb, both in the accent -->
    <Style x:Key="Sl" TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="16" Background="Transparent">
              <Border Height="2" Background="{StaticResource Track}" VerticalAlignment="Center" Margin="7,0"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="7,0,0,0"/></Grid></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False" IsTabStop="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False" Cursor="Hand">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Sunken}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Bare" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox"><Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Status}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="6" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Pill}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Width="8">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Focusable="False" IsTabStop="False" Opacity="0"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Focusable="False" IsTabStop="False" Opacity="0"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#3B3734" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="62"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- the rail: mark on top, pages below it, settings at the bottom; the pill slides between them (code) -->
  <Border x:Name="Rail" Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line2}" BorderThickness="0,0,1,0">
    <Grid x:Name="RailGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Canvas x:Name="RailCanvas" Grid.RowSpan="3">
        <Border x:Name="RailPill" Width="42" Height="42" CornerRadius="12" Background="{StaticResource Pill}" Opacity="0">
          <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
        </Border>
      </Canvas>
      <Grid x:Name="LogoHost" Background="Transparent" ToolTip="Home" Cursor="Hand" Margin="0,20,0,16">
        <Border x:Name="Mark" Width="13" Height="13" CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
        </Border>
      </Grid>
      <StackPanel x:Name="NavHost" Grid.Row="1"/>
      <StackPanel x:Name="NavBottom" Grid.Row="2" Margin="0,0,0,20"/>
    </Grid>
  </Border>

  <!-- the pages: one host, one visible at a time; its natural size drives the window (code) -->
  <Grid Grid.Column="1" ClipToBounds="True">
    <Grid x:Name="PageHost" HorizontalAlignment="Left" VerticalAlignment="Top" Width="398">

      <!-- ============ HOME ============ -->
      <StackPanel x:Name="PageHome" Margin="24,24,24,20">
        <Grid x:Name="HeadHome" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TxtHomeTitle" Style="{StaticResource Title}" Text="Balanced"/>
            <Border x:Name="DemoBadge" Visibility="Collapsed" Margin="8,1,0,0" CornerRadius="4" Background="#33F3821D" Padding="5,1" VerticalAlignment="Center" ToolTip="Not running as administrator: hardware is simulated">
              <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="#F3821D" FontFamily="{DynamicResource UiFont}"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="TxtHomeStatus" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
        </Grid>

        <Border x:Name="ErrBanner" Visibility="Collapsed" Background="#26FF5C5C" CornerRadius="8" Padding="10,8" Margin="0,20,0,0">
          <TextBlock x:Name="TxtErr" Style="{StaticResource Cap}" Foreground="#FF9A9A"/>
        </Border>
        <Border x:Name="InfoBanner" Visibility="Collapsed" Background="#1F3F8CFF" CornerRadius="8" Padding="10,8" Margin="0,20,0,0">
          <TextBlock x:Name="TxtInfo" Style="{StaticResource Cap}" Foreground="#B9CDF7"/>
        </Border>

        <Grid Margin="0,24,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource Big}"><Run x:Name="BigCpu" Text="--"/><Run Text="°C" FontSize="18" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
            <TextBlock x:Name="SubCpu" Style="{StaticResource Cap}" Text="CPU" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="20,0,0,18">
            <TextBlock Style="{StaticResource Big}"><Run x:Name="BigGpu" Text="--"/><Run Text="°C" FontSize="18" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
            <TextBlock x:Name="SubGpu" Style="{StaticResource Cap}" Text="GPU" Margin="0,6,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Big}"><Run x:Name="BigFan1" Text="--"/><Run Text=" rpm" FontSize="15" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
              <TextBlock Text="CPU fan" Style="{StaticResource Cap}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,18,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Big}"><Run x:Name="BigFan2" Text="--"/><Run Text=" rpm" FontSize="15" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
              <TextBlock Text="GPU fan" Style="{StaticResource Cap}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="ModeHost" Margin="0,24,0,0"/>

        <Grid x:Name="FanRow" Margin="0,24,0,0">
          <TextBlock Text="Fans" Style="{StaticResource Row}"/>
          <Border x:Name="FanLinksHost" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="PowerRow" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Power gain" Style="{StaticResource Row}" ToolTip="What OMEN Gaming Hub calls Smart Performance Gain: a bigger shared CPU + GPU power budget"/>
          <Slider x:Name="SlPower" Grid.Column="1" Style="{StaticResource Sl}" Minimum="0" Maximum="15" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="18,0,18,0"/>
          <TextBlock x:Name="TxtPower" Grid.Column="2" Style="{StaticResource MonoVal}" Width="46" Text="+0 W"/>
        </Grid>
        <Grid x:Name="LightRow" Margin="0,20,0,0" Background="Transparent" Cursor="Hand">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Lighting" Style="{StaticResource Row}"/>
            <TextBlock x:Name="TxtLightSub" Style="{StaticResource Cap}" Text="Static · 4 zones" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="MiniHost" Width="145" VerticalAlignment="Center"/>
            <TextBlock Text="→" FontFamily="{DynamicResource UiFont}" FontSize="15" Foreground="{DynamicResource Accent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Border Margin="0,24,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="DotHb" Width="6" Height="6" Fill="#4AC06C" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="TxtFoot" Style="{StaticResource MonoFoot}"/>
            </StackPanel>
            <TextBlock x:Name="TxtFootRight" Style="{StaticResource MonoFoot}" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ============ FANS ============ -->
      <StackPanel x:Name="PageFans" Margin="24,24,24,20" Visibility="Collapsed">
        <Grid x:Name="HeadFans" Background="Transparent">
          <TextBlock Text="Fans" Style="{StaticResource Title}"/>
          <TextBlock x:Name="TxtFansStatus" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
        </Grid>
        <Border x:Name="FanSegHost" Margin="0,24,0,0"/>

        <!-- Auto and Curve: the graph -->
        <StackPanel x:Name="CurveBlock" Margin="0,24,0,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TxtCurveTitle" Style="{StaticResource Row}" Text="CPU curve"/>
              <Border x:Name="CurveWhichHost" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="TxtCurveHint" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Desc}" HorizontalAlignment="Right"/>
          </Grid>
          <Border x:Name="CurveHost" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- Max: what it is doing and for how long -->
        <Grid x:Name="MaxBlock" Margin="0,24,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource Big}"><Run x:Name="MaxFan1" Text="--"/><Run Text=" rpm" FontSize="15" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
            <TextBlock x:Name="MaxFan1Sub" Style="{StaticResource Cap}" Text="CPU fan" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="20,0,0,18">
            <TextBlock Style="{StaticResource Big}"><Run x:Name="MaxFan2" Text="--"/><Run Text=" rpm" FontSize="15" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
            <TextBlock x:Name="MaxFan2Sub" Style="{StaticResource Cap}" Text="GPU fan" Margin="0,6,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Big}"><Run x:Name="MaxTemp" Text="--"/><Run Text="°C" FontSize="18" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
              <TextBlock x:Name="MaxTempSub" Style="{StaticResource Cap}" Text="CPU" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,18,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Big}"><Run x:Name="MaxMins" Text="0"/><Run x:Name="MaxMinsUnit" Text=" min" FontSize="15" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
              <TextBlock x:Name="MaxMinsSub" Style="{StaticResource Cap}" Text="Running at max" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Manual: the two levels as percentages -->
        <Grid x:Name="ManualBlock" Margin="0,24,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Big}"><Run x:Name="ManPct1" Text="--"/><Run Text="%" FontSize="18" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
            <TextBlock x:Name="ManSub1" Style="{StaticResource Cap}" Text="CPU fan" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Style="{StaticResource Big}"><Run x:Name="ManPct2" Text="--"/><Run Text="%" FontSize="18" FontWeight="Normal" Foreground="#96918D"/></TextBlock>
            <TextBlock x:Name="ManSub2" Style="{StaticResource Cap}" Text="GPU fan" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>

        <!-- per-mode controls -->
        <Grid x:Name="OptsAuto" Margin="0,24,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock Text="Quieter policy for Eco" Style="{StaticResource Row}"/>
            <TextBlock Text="Cool profile instead of the default" Style="{StaticResource Cap}" Margin="0,3,0,0"/>
          </StackPanel>
          <ToggleButton x:Name="TgEcoCool2" Grid.Column="1" Style="{StaticResource SwitchBig}"/>
        </Grid>

        <StackPanel x:Name="OptsCurve" Margin="0,24,0,0" Visibility="Collapsed">
          <Grid>
            <TextBlock Text="Link GPU fan to CPU curve" Style="{StaticResource Row}"/>
            <ToggleButton x:Name="TgLink" Style="{StaticResource SwitchBig}" HorizontalAlignment="Right" ToolTip="On: one curve, both fans follow the hotter chip. Off: a curve per fan."/>
          </Grid>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Floor" Style="{StaticResource Row}" ToolTip="The lowest speed the curve may hold, whatever the temperature"/>
            <Slider x:Name="SlFloor" Grid.Column="1" Style="{StaticResource Sl}" Minimum="18" Maximum="45" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="18,0,18,0"/>
            <TextBlock x:Name="TxtFloor" Grid.Column="2" Style="{StaticResource MonoVal}"/>
          </Grid>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Ramp delay" Style="{StaticResource Row}" ToolTip="How gently the fans follow the curve: seconds per 300 rpm step"/>
            <Slider x:Name="SlRamp" Grid.Column="1" Style="{StaticResource Sl}" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="18,0,18,0"/>
            <TextBlock x:Name="TxtRamp" Grid.Column="2" Style="{StaticResource MonoVal}"/>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="OptsMax" Margin="0,24,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="Back to Auto when cool" Style="{StaticResource Row}"/>
              <TextBlock x:Name="TxtMaxCoolSub" Style="{StaticResource Cap}" Margin="0,3,0,0"/>
            </StackPanel>
            <ToggleButton x:Name="TgMaxCool" Grid.Column="1" Style="{StaticResource SwitchBig}"/>
          </Grid>
          <Grid Margin="0,20,0,0">
            <TextBlock Text="Stop after" Style="{StaticResource Row}"/>
            <Border x:Name="StopAfterHost" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="OptsManual" Margin="0,24,0,0" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="CPU fan" Style="{StaticResource Row}"/>
            <Slider x:Name="SlFan1" Grid.Column="1" Style="{StaticResource Sl}" Minimum="18" Maximum="57" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="18,0,18,0"/>
            <TextBlock x:Name="TxtFan1" Grid.Column="2" Style="{StaticResource MonoVal}"/>
          </Grid>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="GPU fan" Style="{StaticResource Row}"/>
            <Slider x:Name="SlFan2" Grid.Column="1" Style="{StaticResource Sl}" Minimum="18" Maximum="57" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="18,0,18,0"/>
            <TextBlock x:Name="TxtFan2" Grid.Column="2" Style="{StaticResource MonoVal}"/>
          </Grid>
          <Grid Margin="0,20,0,0">
            <TextBlock Text="Move both together" Style="{StaticResource Row}"/>
            <ToggleButton x:Name="TgManualLink" Style="{StaticResource SwitchBig}" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Ellipse Width="6" Height="6" Fill="#F3821D" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="TxtGuardNote" Style="{StaticResource Cap}" Foreground="{StaticResource Hex}" TextWrapping="NoWrap" Text="For your safety, Ohman forces max fan above 90°"/>
          </StackPanel>
        </StackPanel>

        <Border Margin="0,24,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
          <Grid>
            <TextBlock x:Name="TxtFanApplied" Style="{StaticResource MonoFoot}" Text="Applied to Balanced"/>
            <TextBlock x:Name="TxtFanRight" Style="{StaticResource MonoFoot}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="BtnFanAction" Style="{StaticResource Link}" FontFamily="{DynamicResource MonoFont}" FontSize="11" HorizontalAlignment="Right" Text="Edit as curve"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ============ KEYBOARD ============ -->
      <StackPanel x:Name="PageKbd" Margin="24,24,24,24" Visibility="Collapsed">
        <Grid x:Name="HeadKbd" Background="Transparent">
          <TextBlock Text="Keyboard" Style="{StaticResource Title}"/>
          <TextBlock x:Name="TxtKbdStatus" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
        </Grid>
        <Border x:Name="KbdModeHost" Margin="0,24,0,0" HorizontalAlignment="Left"/>

        <Grid x:Name="SelectRow" Margin="0,22,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Select" Style="{StaticResource Row}" FontSize="13" Foreground="{StaticResource SegText}" Margin="0,0,10,0"/>
            <Border x:Name="GranHost" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TxtKeySel" Style="{StaticResource Mono}" Foreground="{StaticResource Desc}" HorizontalAlignment="Right" Text="Click the map to select"/>
        </Grid>

        <Border x:Name="KbdHost" Margin="0,22,0,0"/>

        <!-- the editor: colour for the per-zone modes, speed + brightness for the firmware effects -->
        <Border x:Name="EditorRow" Margin="0,22,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
          <Grid>
            <StackPanel x:Name="ColorEditor">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Grid Height="34">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Status}" VerticalAlignment="Center" Margin="0,0,9,0" ToolTip="Colour"/>
                    <Border Grid.Column="1" Height="34" Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}" BorderThickness="1" ClipToBounds="True">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="HexChip" Background="#3F8CFF"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                          <TextBlock Text="#" FontFamily="{DynamicResource MonoFont}" FontSize="13.5" Foreground="#7E7976" VerticalAlignment="Center" Margin="0,0,4,0"/>
                          <TextBox x:Name="TxtHex" Style="{StaticResource Bare}" MaxLength="6" Width="70" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                  <Grid Height="26" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Status}" VerticalAlignment="Center" Margin="0,0,9,0" ToolTip="Brightness"/>
                    <Slider x:Name="SlLevel" Grid.Column="1" Style="{StaticResource Sl}" Minimum="5" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtLevel" Grid.Column="2" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Hex}" Width="34" TextAlignment="Right"/>
                  </Grid>
                </StackPanel>
                <Border Grid.Column="2" ClipToBounds="True" VerticalAlignment="Top">
                  <StackPanel>
                    <Border x:Name="HueHost" Height="33"/>
                    <Border x:Name="ShadeHost" Height="33"/>
                  </StackPanel>
                </Border>
              </Grid>
              <!-- breathe is the one mode with both a colour and a speed; its speed is the same row cycle and wave use -->
              <Grid x:Name="SpeedInline" Height="26" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Speed" Style="{StaticResource Row}" FontSize="13"/>
                <Slider x:Name="SlSpeed2" Grid.Column="1" Style="{StaticResource Sl}" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="12,0,12,0"/>
                <TextBlock x:Name="TxtSpeed2" Grid.Column="2" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Hex}" Width="32" TextAlignment="Right"/>
              </Grid>
            </StackPanel>

            <Grid x:Name="EffectEditor" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Speed" Style="{StaticResource Row}" FontSize="13"/>
                <Slider x:Name="SlSpeed" Grid.Column="1" Style="{StaticResource Sl}" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="12,0,12,0"/>
                <TextBlock x:Name="TxtSpeed" Grid.Column="2" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Hex}" Width="32" TextAlignment="Right"/>
              </Grid>
              <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Brightness" Style="{StaticResource Row}" FontSize="13"/>
                <Slider x:Name="SlLevel2" Grid.Column="1" Style="{StaticResource Sl}" Minimum="5" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Margin="12,0,12,0"/>
                <TextBlock x:Name="TxtLevel2" Grid.Column="2" Style="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Hex}" Width="32" TextAlignment="Right"/>
              </Grid>
            </Grid>

            <StackPanel x:Name="KbdInfo" Visibility="Collapsed">
              <TextBlock x:Name="TxtKbdInfo" Style="{StaticResource Hint}"/>
              <TextBlock x:Name="BtnWinLighting" Style="{StaticResource Link}" FontSize="13" Text="Open Windows lighting settings" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ============ SETTINGS ============ -->
      <Grid x:Name="PageSettings" Height="640" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="HeadSettings" Background="Transparent" Margin="24,24,24,16">
          <TextBlock Text="Settings" Style="{StaticResource Title}"/>
          <TextBlock x:Name="TxtMachine" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
        </Grid>
        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="24,4,16,8">
          <StackPanel>

            <TextBlock x:Name="SecKey" Text="OMEN KEY" Margin="0,0,0,12"/>
            <TextBlock Text="Opens" Style="{StaticResource Row}"/>
            <Border x:Name="KeySegHost" Margin="0,8,0,0"/>
            <Grid Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="KeyDot" Width="6" Height="6" Fill="#4AC06C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtKeyInfo" Style="{StaticResource Cap}" Text="OMEN key auto-detected"/>
              </StackPanel>
              <TextBlock x:Name="BtnLearn" Style="{StaticResource Link}" Text="Relearn" HorizontalAlignment="Right" ToolTip="Click, then press the key you want to bind"/>
            </Grid>
            <Grid x:Name="KeyCmdRow" Visibility="Collapsed" Margin="0,10,0,0">
              <TextBox x:Name="TxtKeyCmd" Style="{StaticResource Field}" FontFamily="{DynamicResource UiFont}" MaxLength="500" ToolTip="Command line the OMEN key starts, e.g. a game launcher or a script"/>
              <TextBlock x:Name="TxtKeyCmdHint" Text="Command line, e.g. steam://open/bigpicture" Style="{StaticResource Cap}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Take over the OMEN key" Style="{StaticResource Row}"/>
                  <TextBlock Text="Stops the vendor key handler and its logon task" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgSuppress" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Hotkeys" Style="{StaticResource Row}"/>
                  <TextBlock Text="Shift+F11 cycles · Ctrl+Alt+E/B/P modes · Ctrl+Alt+M max fan · Ctrl+Alt+O panel" Style="{StaticResource RowSub}" FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
                </StackPanel>
                <ToggleButton x:Name="TgHotkeys" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>

            <TextBlock x:Name="SecPower" Text="POWER" Margin="0,26,0,6"/>
            <Border x:Name="GpuRow" BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="GPU power" Style="{StaticResource Row}"/>
                  <TextBlock x:Name="TxtGpuSub" Text="Follows the mode" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <Border x:Name="GpuSegHost" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Eco on battery" Style="{StaticResource Row}"/>
                  <TextBlock Text="Restores your mode when plugged in" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgEcoBattery" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Sync Windows power mode" Style="{StaticResource Row}"/>
                  <TextBlock Text="Efficiency · Balanced · Best performance" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgSyncPower" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Thermal guard" Style="{StaticResource Row}"/>
                  <TextBlock x:Name="TxtGuardSub" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgGuard" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>

            <TextBlock x:Name="SecDisplay" Text="DISPLAY" Margin="0,26,0,6"/>
            <Border x:Name="GfxRow" Visibility="Collapsed" BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Graphics" Style="{StaticResource Row}"/>
                  <TextBlock x:Name="TxtGfxSub" Text="Takes effect after a restart" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <Border x:Name="GfxSegHost" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border x:Name="HzRow" Visibility="Collapsed" BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Refresh rate" Style="{StaticResource Row}"/>
                  <TextBlock Text="Built-in display" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <Border x:Name="HzSegHost" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border x:Name="LowHzRow" Visibility="Collapsed" BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Lowest refresh rate on battery" Style="{StaticResource Row}"/>
                  <TextBlock Text="Back to your choice when plugged in" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgLowHzBattery" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>

            <TextBlock x:Name="SecApp" Text="APP" Margin="0,26,0,6"/>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Temperature in the tray" Style="{StaticResource Row}"/>
                  <TextBlock Text="CPU temperature drawn on the tray icon" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgTrayTemp" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Start with Windows" Style="{StaticResource Row}"/>
                  <TextBlock Text="Scheduled task, no prompt at logon" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="TgAutostart" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </Border>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0" Padding="0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                  <TextBlock Text="Check for updates" Style="{StaticResource Row}"/>
                  <TextBlock x:Name="TxtUpdate" Style="{StaticResource RowSub}" FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="BtnUpdate" Grid.Column="1" Style="{StaticResource Link}" Text="Check now" Margin="0,0,18,0"/>
                <ToggleButton x:Name="TgUpdateAuto" Grid.Column="2" Style="{StaticResource Switch}" ToolTip="Check once a day when Ohman starts"/>
              </Grid>
            </Border>
            <TextBlock x:Name="TxtDiag" Style="{StaticResource Mono}" FontSize="10.5" Margin="0,14,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,16">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="BtnDiag" Style="{StaticResource Link}" FontSize="13" Foreground="{StaticResource SegText}" Text="Diagnostics"/>
            <TextBlock x:Name="BtnLog" Style="{StaticResource Link}" FontSize="13" Foreground="{StaticResource SegText}" Text="Log" Margin="22,0,0,0"/>
            <TextBlock x:Name="BtnExit" Style="{StaticResource Link}" FontSize="13" Text="Exit Ohman" Margin="22,0,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- hide to tray: invisible until the pointer is over the window, so the pages stay exactly as designed -->
    <Button x:Name="BtnClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Opacity="0" ToolTip="Hide (keeps running in the tray) · Esc"/>

    <!-- transient status, over the page bottom -->
    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,14" CornerRadius="8" Background="#D4100D0B" BorderBrush="#2C2825" BorderThickness="1" Padding="12,7" Opacity="0" IsHitTestVisible="False">
      <TextBlock x:Name="TxtToast" Style="{StaticResource Cap}" Foreground="{StaticResource Text}" TextWrapping="NoWrap"/>
    </Border>
  </Grid>
</Grid>
